{% doc %}
  @prompt
    make a carousel that can have up to 5 images that change every 5 seconds, also they have a button that can be anywhere in the section or hidden individually per slider, change color and also set the link it links to.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-carousel-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
    pointer-events: none;
  }

  .ai-carousel-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-carousel-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--top-left {
    top: 20px;
    left: 20px;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--top-center {
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--top-right {
    top: 20px;
    right: 20px;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--center-left {
    top: 50%;
    left: 20px;
    transform: translateY(-50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--center-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--center-right {
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--bottom-left {
    bottom: 20px;
    left: 20px;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--bottom-center {
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--bottom-right {
    bottom: 20px;
    right: 20px;
  }

  .ai-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    text-decoration: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 600;
    transition: opacity 0.3s ease;
  }

  .ai-carousel-button-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-carousel-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 3;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    background-color: rgba(255, 255, 255, 1);
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: background-color 0.3s ease;
  }

  .ai-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, 0.7);
  }

  .ai-carousel-nav-{{ ai_gen_id }}--prev {
    left: 10px;
  }

  .ai-carousel-nav-{{ ai_gen_id }}--next {
    right: 10px;
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-button-wrapper-{{ ai_gen_id }} {
      position: static;
      transform: none;
      padding: 20px;
      text-align: center;
    }

    .ai-carousel-slides-{{ ai_gen_id }} {
      padding-bottom: 75%;
    }
  }
{% endstyle %}

<image-carousel-{{ ai_gen_id }} class="ai-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-slides-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        assign slide_image_key = 'slide_' | append: i | append: '_image'
        assign slide_button_enabled_key = 'slide_' | append: i | append: '_button_enabled'
        assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
        assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'
        assign slide_button_position_key = 'slide_' | append: i | append: '_button_position'
        assign slide_button_bg_key = 'slide_' | append: i | append: '_button_bg_color'
        assign slide_button_text_color_key = 'slide_' | append: i | append: '_button_text_color'

        assign slide_enabled = block.settings[slide_enabled_key]
        assign slide_image = block.settings[slide_image_key]
        assign slide_button_enabled = block.settings[slide_button_enabled_key]
        assign slide_button_text = block.settings[slide_button_text_key]
        assign slide_button_link = block.settings[slide_button_link_key]
        assign slide_button_position = block.settings[slide_button_position_key]
        assign slide_button_bg = block.settings[slide_button_bg_key]
        assign slide_button_text_color = block.settings[slide_button_text_color_key]
      %}

      {% if slide_enabled %}
        <div class="ai-carousel-slide-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}" data-slide="{{ i }}">
          {% if slide_image %}
            <img
              src="{{ slide_image | image_url: width: 2000 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="lazy"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
            >
          {% else %}
            <div class="ai-carousel-slide-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if slide_button_enabled and slide_button_text != blank %}
            <div class="ai-carousel-button-wrapper-{{ ai_gen_id }} ai-carousel-button-wrapper-{{ ai_gen_id }}--{{ slide_button_position }}">
              <a
                href="{{ slide_button_link }}"
                class="ai-carousel-button-{{ ai_gen_id }}"
                style="background-color: {{ slide_button_bg }}; color: {{ slide_button_text_color }};"
              >
                {{ slide_button_text }}
              </a>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.show_navigation %}
    <button class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-{{ ai_gen_id }}--prev" aria-label="Previous slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-{{ ai_gen_id }}--next" aria-label="Next slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  {% endif %}

  {% if block.settings.show_dots %}
    <div class="ai-carousel-dots-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_enabled = block.settings[slide_enabled_key]
        %}
        {% if slide_enabled %}
          <button
            class="ai-carousel-dot-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}"
            data-slide="{{ i }}"
            aria-label="Go to slide {{ i }}"
          ></button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</image-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-carousel-nav-{{ ai_gen_id }}--prev');
        this.nextButton = this.querySelector('.ai-carousel-nav-{{ ai_gen_id }}--next');

        this.enabledSlides = this.slides.filter(slide => slide.dataset.slide);

        if (this.enabledSlides.length === 0) return;

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToPrevSlide();
            this.resetAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToNextSlide();
            this.resetAutoplay();
          });
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            this.resetAutoplay();
          });
        });
      }

      goToSlide(index) {
        this.enabledSlides[this.currentSlide].classList.remove('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.enabledSlides[this.currentSlide].classList.add('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      goToNextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.enabledSlides.length;
        this.goToSlide(nextIndex);
      }

      goToPrevSlide() {
        const prevIndex = (this.currentSlide - 1 + this.enabledSlides.length) % this.enabledSlides.length;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        if (this.enabledSlides.length <= 1) return;

        this.autoplayInterval = setInterval(() => {
          this.goToNextSlide();
        }, 5000);
      }

      resetAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

