{% doc %}
  @prompt
    can you make a carousel section of up to 5 images and let me add a button and choose the location of it on top of the image, also the color, height and width, i need the carousel to contain the images
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: {{ block.settings.carousel_height }}px;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    min-width: 100%;
    height: 100%;
    position: relative;
    flex-shrink: 0;
  }

  .ai-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--top-left {
    top: 20px;
    left: 20px;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--top-center {
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--top-right {
    top: 20px;
    right: 20px;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--center-left {
    top: 50%;
    left: 20px;
    transform: translateY(-50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--center-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--center-right {
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--bottom-left {
    bottom: 20px;
    left: 20px;
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--bottom-center {
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
  }

  .ai-carousel-button-wrapper-{{ ai_gen_id }}--bottom-right {
    bottom: 20px;
    right: 20px;
  }

  .ai-carousel-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 500;
    transition: opacity 0.3s ease;
    width: {{ block.settings.button_width }}px;
    height: {{ block.settings.button_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-cta-button-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(255, 255, 255, 0.8);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: background-color 0.3s ease;
  }

  .ai-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 1);
  }

  .ai-carousel-nav-{{ ai_gen_id }}--prev {
    left: 10px;
  }

  .ai-carousel-nav-{{ ai_gen_id }}--next {
    right: 10px;
  }

  .ai-carousel-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: #121212;
  }

  .ai-carousel-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 3;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    background-color: rgba(255, 255, 255, 1);
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-{{ ai_gen_id }} {
      height: {{ block.settings.carousel_height | times: 0.6 }}px;
    }

    .ai-carousel-cta-button-{{ ai_gen_id }} {
      width: {{ block.settings.button_width | times: 0.8 }}px;
      height: {{ block.settings.button_height | times: 0.8 }}px;
      font-size: 14px;
      padding: 10px 20px;
    }
  }
{% endstyle %}

<image-carousel-{{ ai_gen_id }} class="ai-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-track-{{ ai_gen_id }}">
    {% liquid
      assign has_images = false
      for i in (1..5)
        assign image_key = 'image_' | append: i
        if block.settings[image_key] != blank
          assign has_images = true
          break
        endif
      endfor
    %}

    {% if has_images %}
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        {% if image != blank %}
          <div class="ai-carousel-slide-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
            <img
              src="{{ image | image_url: width: 2000 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
            {% if block.settings.show_button %}
              <div class="ai-carousel-button-wrapper-{{ ai_gen_id }} ai-carousel-button-wrapper-{{ ai_gen_id }}--{{ block.settings.button_position }}">
                {% if block.settings.button_link != blank %}
                  <a href="{{ block.settings.button_link }}" class="ai-carousel-cta-button-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                  </a>
                {% else %}
                  <span class="ai-carousel-cta-button-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                  </span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="ai-carousel-slide-{{ ai_gen_id }}" data-slide="0">
        <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-carousel-empty-state-{{ ai_gen_id }}">
            Next, add images to your carousel
          </div>
        </div>
      </div>
    {% endif %}
  </div>

  {% if has_images %}
    {% liquid
      assign slide_count = 0
      for i in (1..5)
        assign image_key = 'image_' | append: i
        if block.settings[image_key] != blank
          assign slide_count = slide_count | plus: 1
        endif
      endfor
    %}

    {% if slide_count > 1 %}
      <button class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-{{ ai_gen_id }}--prev" aria-label="Previous slide">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>

      <button class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-{{ ai_gen_id }}--next" aria-label="Next slide">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>

      <div class="ai-carousel-dots-{{ ai_gen_id }}">
        {% for i in (1..slide_count) %}
          <button
            class="ai-carousel-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-slide="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</image-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-carousel-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-carousel-nav-{{ ai_gen_id }}--prev');
        this.nextButton = this.querySelector('.ai-carousel-nav-{{ ai_gen_id }}--next');
        this.dots = this.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');

        if (this.slides.length <= 1) return;

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideIndex = parseInt(e.target.dataset.slide);
            this.goToSlide(slideIndex);
          });
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());
      }

      goToSlide(index) {
        this.currentSlide = index;
        const offset = -100 * this.currentSlide;
        this.track.style.transform = `translateX(${offset}%)`;
        this.updateDots();
      }

      goToNextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(this.currentSlide);
      }

      goToPrevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(this.currentSlide);
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        if (this.slides.length <= 1) return;
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.goToNextSlide();
        }, 5000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "range",
      "id": "carousel_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Carousel height",
      "default": 500
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "center-left",
          "label": "Center left"
        },
        {
          "value": "center-center",
          "label": "Center"
        },
        {
          "value": "center-right",
          "label": "Center right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "center-center"
    },
    {
      "type": "range",
      "id": "button_width",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Width",
      "default": 150
    },
    {
      "type": "range",
      "id": "button_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Height",
      "default": 45
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Image carousel"
    }
  ]
}
{% endschema %}
